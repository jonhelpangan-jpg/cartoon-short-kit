{
  "name": "cartoon-short-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop launcher for the original Cartoon Short Kit preview",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jonhelpangan.cartoonshortkit",
    "productName": "Cartoon Short Kit",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "*.js",
      "lib/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
